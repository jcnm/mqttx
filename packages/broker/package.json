{
  "name": "@sparkplug/broker",
  "version": "1.0.0",
  "description": "Sparkplug Compliant & Aware MQTT broker with Fastify REST API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sparkplug/codec": "workspace:*",
    "@sparkplug/namespace": "workspace:*",
    "@sparkplug/state": "workspace:*",
    "fastify": "^5.7.4",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "aedes": "^0.51.3",
    "aedes-persistence-redis": "^11.0.0",
    "mqtt": "^5.15.0",
    "ws": "^8.19.0",
    "websocket-stream": "^5.5.2",
    "ioredis": "^5.9.2",
    "better-sqlite3": "^12.6.2",
    "yaml": "^2.8.2",
    "ajv": "^8.17.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-prometheus": "^0.211.0",
    "dotenv": "^17.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.7.2",
    "tsx": "^4.21.0",
    "vitest": "^3.0.5"
  }
}
